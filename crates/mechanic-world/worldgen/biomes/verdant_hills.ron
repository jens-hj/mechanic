// Familiar temperate ground: rolling grassy hills, dirt on the slopes, grey
// granite on the steepest faces, and weathered boulders half sunk in the turf.
// The world spawns here.
Biome(
    name: "verdant_hills",
    climate: (temperature: 0.0, humidity: 0.2, continentalness: 0.25, weirdness: -0.35),

    height: Add([
        C(14),
        Ref("rolling"),
        Mul([Pow(Ref("crests"), 3), C(18)]),
        Ref("grain"),
    ]),

    let: {
        "boulders": Scatter(
            cell: 36, reach: 6, chance: 0.4,
            ground: Ref("height"), lift: (-0.6, -0.2), tilt: 25,
            vars: {"r": (1.2, 2.8), "chip": (0.8, 1.2)},
            shape: Ref("jointed_rock"),
        ),
    },

    density: SmoothUnion(0.25, [
        Height(Ref("height")),
        Ref("boulders"),
    ]),

    surface: [
        // Rock stays rock on its flat top and throughout its buried body.
        (when: Field(Ref("boulders"), -0.15, inf), use: "granite"),
        // Established beds and the narrow bare shore precede vegetation.
        (when: All([WaterDepth(-0.35, 0), Up(0.55, 1), Depth(0, 0.8)]), use: "loam"),
        (when: All([WaterDepth(0, inf), NearRiver(9), Up(0.55, 1), Depth(0, 0.8)]), use: "river_gravel"),
        (when: All([WaterDepth(0, inf), Up(0.55, 1), Depth(0, 0.8)]), use: "mire_mud"),
        (when: All([WaterDepth(-0.35, inf), Not(Up(0.55, 1)), Depth(0, 0.8)]), use: "granite"),
        (when: All([NearRiver(9), Depth(0, 0.8)]), use: "river_gravel"),
        // No grass underground: tunnel and ramp floors are bare loam.
        (when: All([Carved(Some("tunnels")), Up(0.5, 1)]), use: "loam"),
        (when: All([Carved(Some("entrances")), Up(0.5, 1)]), use: "loam"),
        (when: All([Up(0.74, 1), Depth(0, 0.18)]), use: "meadow_grass"),
        (when: All([Up(0.5, 1), Depth(0, 1.4)]), use: "loam"),
        (when: All([Depth(2.5, 1000), Field(Noise(freq: 0.07, octaves: 2, seed: 9), 0.62, 1)]), use: "iron_seam"),
        (when: Always, use: "granite"),
    ],

    // Open oak and birch woodland, with spruce on the higher crests.
    flora: [
        (species: "oak", cell: 14, chance: 0.35),
        (species: "birch", cell: 11, chance: 0.3),
        (species: "spruce", cell: 10, chance: 0.5, mask: Sub(Ref("height"), C(26))),
    ],
)

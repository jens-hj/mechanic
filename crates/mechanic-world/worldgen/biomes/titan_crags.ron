// Huge ridged mountains broken into stepped cliff bands. A slow 3D warp
// pushes the cliff faces in and out, so the bands overhang; snow settles on
// the high ledges and copper shows in the walls.
Biome(
    name: "titan_crags",
    climate: (temperature: -0.5, humidity: 0.0, continentalness: 0.6, weirdness: -0.1),

    // Few octaves on purpose: the warp below makes the height a per-point
    // lookup, and the terrace flattens finer detail anyway.
    height: Add([
        C(55),
        Mul([
            Pow(Remap(Noise(fractal: Ridged, freq: 0.0011, octaves: 4, dims: Two, seed: 3), (-1, 1), (0, 1)), 2.2),
            C(230),
        ]),
        Noise(freq: 0.004, amp: 9, dims: Two, seed: 1),
    ]),

    let: {
        "ledge": Terrace(of: Ref("height"), step: 26, sharpness: 0.5),
        // Four-metre probes select terrace edges, excluding broad flat treads.
        "cliff_edge": Sub(Max([
            Abs(Sub(Translate((4, 0, 0), Ref("ledge")), Translate((-4, 0, 0), Ref("ledge")))),
            Abs(Sub(Translate((0, 0, 4), Ref("ledge")), Translate((0, 0, -4), Ref("ledge")))),
        ]), C(4)),
        "edge_blocks": Scatter(
            cell: 15, reach: 13, chance: 0.65, seed: 31,
            mask: Ref("cliff_edge"),
            ground: Ref("ledge"), lift: (-3.0, -1.8), tilt: 10, yaw: false,
            vars: {
                "r": (2.7, 5.0), "cut": (0.62, 0.96), "phase": (0, 500),
                "width": (0.75, 1.3), "rise": (0.9, 1.5), "depth": (0.7, 1.25), "lean": (-0.18, 0.18),
            },
            // Regional joint direction, but independently eroded masses. Nearby
            // overlapping placements form outcrops without a repeated cluster.
            shape: RotateY(23, Ref("weathered_rock")),
        ),
        "rock_formations": Warp(
            by: (kind: SimplexSmooth, freq: 0.011, amp: 9, seed: 2),
            vertical: 0.35,
            of: Ref("edge_blocks"),
        ),
    },

    // Warp the cliffs and their embedded blocks together, keeping their roots
    // attached even where the cliff leans into an overhang.
    density: Warp(
        by: (kind: SimplexSmooth, freq: 0.011, amp: 9, seed: 2),
        vertical: 0.35,
        of: Union([Height(Ref("ledge")), Ref("edge_blocks")]),
    ),

    rivers: 0.8,

    surface: [
        // Established beds and the narrow bare shore precede vegetation.
        (when: All([WaterDepth(-0.35, inf), Up(0.55, 1), Depth(0, 0.8)]), use: "river_gravel"),
        (when: All([WaterDepth(-0.35, inf), Not(Up(0.55, 1)), Depth(0, 0.8)]), use: "granite_grey"),
        (when: Carved(None), use: "dark_granite"),
        (when: All([Altitude(175, 1000), Up(0.55, 1), Depth(0, 0.6)]), use: "snow"),
        (when: All([Field(Ref("rock_formations"), -0.15, inf), Up(0.2, 1), Field(Noise(freq: 0.5, octaves: 2, seed: 151), 0.05, 1)]), use: "weathered_granite"),
        (when: Field(Ref("rock_formations"), -0.15, inf), use: "granite_grey"),
        (when: All([Up(0.72, 1), Depth(0, 0.22)]), use: "alpine_turf"),
        (when: Ceiling, use: "dark_granite"),
        (when: Field(Noise(freq: 0.02, octaves: 2, seed: 3), 0.6, 1), use: "copper_vein"),
        (when: Always, use: "granite_grey"),
    ],

    // Spruce on the gentler ledges, up to the snow line.
    flora: [
        (species: "spruce", cell: 9, chance: 0.45, mask: Sub(C(168), Ref("height"))),
    ],
)
